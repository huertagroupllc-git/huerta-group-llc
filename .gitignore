# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI cache
supabase/.temp/

# workbench — staging for pre-admission working material (uncommitted by
# policy; see workbench/README.md). Only the charter and the OSPA
# recovered-source custody set are tracked.
/workbench/*
!/workbench/README.md

# OSPA custody residue — a NARROW, closed exception covering exactly three
# tracked paths, under fd-0010 (custody) as scoped by fd-0011 (FD-V7).
#
# The six admitted sections S01–S04, S09 and S10 have LEFT the workbench:
# FD-V7 admitted them to the canonical corpus and they now live at
# institution/foundations/operations/. What remains tracked here is the
# derived RS05-EV01 evidence packet — which is NOT canonical OSPA authority
# and is never admissible as canonical source — plus the two custody records.
#
# This exception is enumerated file-by-file on purpose. A recursive
# un-ignore would silently extend it to future reconstruction working
# material, which fd-0001 determination 1 excludes and which fd-0011
# confirms remains governing for every workbench artifact other than the
# exact seven Phase 1 preserved artifacts. There is no blanket workbench
# admission.
!/workbench/ospa-reconstruction/
/workbench/ospa-reconstruction/*
!/workbench/ospa-reconstruction/OSPA-FND-V1-RS05-EV01-verified-canonical-evidence-packet.md
!/workbench/ospa-reconstruction/CUSTODY.md
!/workbench/ospa-reconstruction/SHA256SUMS
