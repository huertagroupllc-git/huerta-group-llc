# Server-side Supabase configuration for the contact inquiry form.
# Values live in .env.local locally and in Vercel project environment
# variables in production. Never commit real values.
#
# Both variables are server-only: neither uses the NEXT_PUBLIC_ prefix,
# so neither is ever included in the client bundle.

# The Huerta Group LLC Supabase project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Secret API key (sb_secret_…) from the Supabase dashboard:
# Project Settings → API Keys. Required because contact_inquiries has
# RLS enabled with no public policies; only trusted server code may
# write. Never expose this key to the browser.
SUPABASE_SECRET_KEY=sb_secret_your-key-here

# --- Inquiry notification (Resend) -----------------------------------
# All three are server-only; none uses the NEXT_PUBLIC_ prefix.

# Resend API key (https://resend.com → API Keys).
RESEND_API_KEY=re_your-key-here

# Approved internal recipient for new-inquiry notifications. Until a
# custom domain is verified with Resend, this must be the address that
# owns the Resend account.
CONTACT_NOTIFICATION_EMAIL=you@example.com

# Optional. Verified sender identity; defaults to Resend's onboarding
# sender until a Huerta Group domain is verified with the provider.
# CONTACT_NOTIFICATION_FROM=Huerta Group Website <onboarding@resend.dev>
